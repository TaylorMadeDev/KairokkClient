# Local development works without an .env file and stores accounts in .data/kairokk.json.
# For production, use PostgreSQL and generate unique secrets (do not reuse examples).
STORAGE_MODE="postgres"
KAIROKK_DATA_FILE=".data/kairokk.json"
DATABASE_URL="postgresql://kairokk:change-me@localhost:5432/kairokk?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
REFRESH_TOKEN_PEPPER="replace-with-a-different-at-least-32-random-characters"
CORS_ORIGIN="http://localhost:5173"
PORT=3000
HOST="127.0.0.1"
NODE_ENV="development"
# Set true only behind HTTPS in production
COOKIE_SECURE=false
